# Sender account UUID from tenant_accounts.id (NOT the GREEN-API idInstance).
TENANT_ACCOUNT_ID=replace_with_tenant_account_uuid

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# GREEN-API MAX
GREEN_API_BASE_URL=https://example.green-api.com
GREEN_API_ID_INSTANCE=replace_me
GREEN_API_TOKEN_INSTANCE=replace_me

# HTTP
HTTP_TIMEOUT_SECONDS=30

# Incoming messages / replies
# Long-poll ReceiveNotification window in seconds (5-60).
RECEIVE_TIMEOUT_SECONDS=10
# Poll GREEN-API for inbound replies and delivery statuses (long-running mode).
POLL_INCOMING_MESSAGES=true

# Logging
LOG_LEVEL=INFO

# --- Optional: legacy smoke-test script (scripts/green_api_smoke_test.py) ---
TEST_PHONE_NUMBER=79991234567
TEST_MESSAGE=Test message from aba-ga-mx-adapter. Please open this message.
SMOKE_TEST_TIMEOUT_SECONDS=180
